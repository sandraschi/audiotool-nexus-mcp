{
  "name": "audiotool-nexus-mcp",
  "version": "0.1.0",
  "description": "MCP server + webapp for Audiotool NEXUS SDK (beta). Tools wrap the SDK; webapp dashboards include decorative metering—see README.",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@audiotool/nexus": "^0.0.12",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
