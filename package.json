{
  "name": "audiotool-nexus-mcp",
  "version": "0.1.0",
  "description": "MCP server + webapp for Audiotool NEXUS SDK — bridge between Claude fleet and Audiotool cloud DAW",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@audiotool/nexus": "^0.0.12",
    "@modelcontextprotocol/sdk": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
