/**
 * Timeline tools — create note tracks and note regions.
 *
 * Musical time uses the Ticks system from the SDK:
 *   Ticks.SemiBreve = 1 whole note (4 beats in 4/4)
 *   The SDK exports a Ticks object with named constants.
 */

import { Ticks } from "@audiotool/nexus";
import type { NexusBridge } from "../nexus-bridge.js";
import type { McpTool } from "../types.js";

export function registerTimelineTools(bridge: NexusBridge): McpTool[] {
  return [
    // ── nexus_ticks_reference ─────────────────────────────────────────────────
    {
      name: "nexus_ticks_reference",
      description:
        "Return the musical time tick constants from the Nexus SDK. " +
        "Use these values when specifying positionTicks and durationTicks " +
        "in nexus_add_note_region. Example: 1 bar = Ticks.SemiBreve.",
      inputSchema: { type: "object", properties: {} },
      handler: async () => ({
        success: true,
        ticks: {
          SemiBreve: Ticks.SemiBreve,
          HalfNote: Ticks.HalfNote ?? Ticks.SemiBreve / 2,
          QuarterNote: Ticks.QuarterNote ?? Ticks.SemiBreve / 4,
          EighthNote: Ticks.EighthNote ?? Ticks.SemiBreve / 8,
          SixteenthNote: Ticks.SixteenthNote ?? Ticks.SemiBreve / 16,
        },
        note:
          "HalfNote/QuarterNote/EighthNote/SixteenthNote may be derived; " +
          "SemiBreve is the guaranteed SDK export. 1 bar (4/4) = 1 SemiBreve.",
      }),
    },

    // ── nexus_create_note_track ───────────────────────────────────────────────
    {
      name: "nexus_create_note_track",
      description:
        "Create a note track in the project timeline and link it to an instrument device. " +
        "The track will appear in the Audiotool timeline view. " +
        "You need the device id (from nexus_query_entities or nexus_create_device) " +
        "to link the track to the correct instrument.",
      inputSchema: {
        type: "object",
        properties: {
          device_id: {
            type: "string",
            description:
              "Id or location reference of the instrument device to link this track to. " +
              "Obtain from nexus_query_entities or nexus_create_device response.",
          },
          order: {
            type: "number",
            description: "Track order in the timeline (0 = first). Default: 0.",
          },
        },
        required: ["device_id"],
      },
      handler: async (args) => {
        const deviceId = String(args["device_id"] ?? "");
        const order = Number(args["order"] ?? 0);

        let createdTrackId: string | null = null;

        const result = await bridge.modify((t) => {
          // SDK v0.0.12: transaction uses insert() not create()
          const track = t.insert("noteTrack", {
            orderAmongTracks: order,
            player: deviceId,
          });
          createdTrackId = track?.location ?? track?.id ?? null;
        });

        return {
          ...result,
          track_id: createdTrackId,
          linked_device: deviceId,
          order,
          note:
            "If device_id is wrong or device doesn't exist, the SDK may " +
            "throw a transaction error. Verify device id via nexus_query_entities.",
        };
      },
    },

    // ── nexus_add_note_region ─────────────────────────────────────────────────
    {
      name: "nexus_add_note_region",
      description:
        "Add a MIDI note region to a note track in the timeline. " +
        "positionTicks: where the region starts (0 = beginning). " +
        "durationTicks: length of the region. " +
        "Use nexus_ticks_reference for tick constants (e.g. SemiBreve = 1 bar in 4/4). " +
        "track_id must be from nexus_create_note_track.",
      inputSchema: {
        type: "object",
        properties: {
          track_id: {
            type: "string",
            description: "Id or location of the target note track.",
          },
          position_ticks: {
            type: "number",
            description:
              "Start position in ticks. 0 = beginning. " +
              "Use multiples of Ticks.SemiBreve for bar-aligned placement.",
          },
          duration_ticks: {
            type: "number",
            description:
              "Duration in ticks. Ticks.SemiBreve = 1 bar (4/4). " +
              "4 * SemiBreve = 4 bars.",
          },
        },
        required: ["track_id", "position_ticks", "duration_ticks"],
      },
      handler: async (args) => {
        const trackId = String(args["track_id"] ?? "");
        const posTicks = Number(args["position_ticks"] ?? 0);
        const durTicks = Number(args["duration_ticks"] ?? Ticks.SemiBreve);

        let createdRegionId: string | null = null;

        const result = await bridge.modify((t) => {
          const region = t.create("noteRegion", {
            track: trackId,
            region: {
              positionTicks: posTicks,
              durationTicks: durTicks,
            },
          });
          createdRegionId = region?.id ?? region?.location ?? null;
        });

        return {
          ...result,
          region_id: createdRegionId,
          track_id: trackId,
          position_ticks: posTicks,
          duration_ticks: durTicks,
          position_bars: `~${(posTicks / Ticks.SemiBreve).toFixed(2)} bars`,
          duration_bars: `~${(durTicks / Ticks.SemiBreve).toFixed(2)} bars`,
        };
      },
    },
  ];
}
