# Copy this file to .env (repo root, next to package.json).
# .env is gitignored — never commit real tokens.
#
# MCP (Node) needs a Personal Access Token — not optional for online sync.
# 1) https://developer.audiotool.com → log in
# 2) https://developer.audiotool.com/personal-access-tokens → create token → copy
# 3) Paste below:
AUDIOTOOL_PAT=your-pat-here
#
# Project URL: open beta studio, create or open a project, copy the URL from the
# address bar (must include ?project=...). Use with nexus_connect and tests:
# AUDIOTOOL_TEST_PROJECT_URL=https://beta.audiotool.com/studio?project=YOUR_ID
AUDIOTOOL_TEST_PROJECT_URL=
